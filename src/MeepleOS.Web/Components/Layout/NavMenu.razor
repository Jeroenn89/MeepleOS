@inject IJSRuntime JS

<header class="site-head">
    <a class="brand" href="/">
        <img class="brand-logo" src="@Assets["meepleos-logo.png"]" alt="" width="36" height="44" />
        <span>MeepleOS</span>
    </a>
    <div class="mobile-menu @(mobileMenuOpen ? "is-open" : "")">
        <button type="button" class="mobile-menu-toggle" aria-label="Menu" aria-expanded="@mobileMenuOpen" @onclick="ToggleMobileMenu">
            <svg class="mobile-menu-open-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
            <svg class="mobile-menu-close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" /></svg>
        </button>
        <nav aria-label="Mobiele hoofdnavigatie" inert="@(!mobileMenuOpen)" @onclick="CloseMobileMenu">
            <AuthorizeView><Authorized Context="accountState"><span class="signed-in-account">Ingelogd als @accountState.User.Identity?.Name</span></Authorized></AuthorizeView>
            <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
            <NavLink href="/games">Bordspellen</NavLink>
            <NavLink href="/wheel">Spelrad</NavLink>
            <NavLink href="/players">Spelers</NavLink>
            <NavLink href="/sessions">Potjes</NavLink>
            <NavLink href="/statistics">Statistieken</NavLink>
            <NavLink href="/manage">Bewerken</NavLink>
            <NavLink href="/chat">Meeple Companion</NavLink>
            <AuthorizeView Roles="Admin"><Authorized><a href="/admin">Admin</a></Authorized></AuthorizeView>
            <a href="/change-password">Wachtwoord wijzigen</a>
            <form method="post" action="/logout"><AntiforgeryToken /><button type="submit">Uitloggen</button></form>
        </nav>
    </div>
    <nav class="desktop-menu" aria-label="Hoofdnavigatie">
        <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
        <NavLink href="/games">Bordspellen</NavLink>
        <NavLink href="/wheel">Spelrad</NavLink>
        <NavLink href="/players">Spelers</NavLink>
        <NavLink href="/sessions">Potjes</NavLink>
        <NavLink href="/statistics">Statistieken</NavLink>
        <NavLink href="/manage">Bewerken</NavLink>
        <NavLink class="chat-link" href="/chat">Meeple Companion</NavLink>
        <details class="account-menu">
            <summary>Account</summary>
            <div class="account-menu-items">
                <AuthorizeView><Authorized Context="accountState"><span class="signed-in-account">Ingelogd als @accountState.User.Identity?.Name</span></Authorized></AuthorizeView>
                <AuthorizeView Roles="Admin"><Authorized><a href="/admin">Admin</a></Authorized></AuthorizeView>
                <a href="/change-password">Wachtwoord wijzigen</a>
                <form method="post" action="/logout"><AntiforgeryToken /><button type="submit">Uitloggen</button></form>
            </div>
        </details>
    </nav>
</header>
<div class="site-head-spacer" aria-hidden="true"></div>

@code {
    private bool mobileMenuOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("meepleHeaderScroll.start");
    }

    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void CloseMobileMenu() => mobileMenuOpen = false;
}
