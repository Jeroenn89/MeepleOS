@page "/games"
@inject BoardgameService GameService
@inject GameSessionService SessionService
<PageTitle>Bordspellen · MeepleOS</PageTitle>
<h1>Bordspelcollectie</h1>
<div class="filters game-collection-filters">
    <label>
        Zoeken
        <input @bind="search" @bind:event="oninput" placeholder="Naam bordspel?" />
    </label>
    <label>
        Spelers
        <input type="number" min="1" @bind="players" placeholder="Met hoeveel spelers?" />
    </label>
    <label>
        Max. minuten
        <input type="number" min="1" @bind="minutes" placeholder="Maximale speeltijd" />
    </label>
</div>
<label class="collection-visibility-filter">
    <input type="checkbox" @bind="showPlayedNotOwned" /> Toon ook niet-bezeten spellen
</label>
<div class="collection-view-toolbar" role="group" aria-label="Weergave bordspellen">
    <span>Weergave</span>
    <button type="button" class="@(viewMode == "grid" ? "selected" : "")" aria-pressed="@(viewMode == "grid")" @onclick="ShowGrid">Met info</button>
    <button type="button" class="@(viewMode == "names" ? "selected" : "")" aria-pressed="@(viewMode == "names")" @onclick="ShowNames">Namen</button>
</div>
@if (games is null)
{
    <p>Laden…</p>
}
else
{
    <div class="game-collection-grid collection-view-@viewMode">
        @foreach (var game in games.Where(MatchesFilters))
        {
            var playCount = playCounts.GetValueOrDefault(game.Id);
            var ownershipLabel = game.IsOwned ? "" : "niet in bezit, ";
            var playLabel = playCount == 0 ? "nog niet gespeeld" : $"{playCount} keer gespeeld";
            var ariaLabel = $"{game.Name}, {ownershipLabel}{playLabel}";
            <a class="card game-collection-card @(!game.IsOwned ? "game-card-not-owned" : cardDecorations.GetValueOrDefault(game.Id))" href="/games/@game.Id" aria-label="@ariaLabel">
                <h2>@game.Name</h2>
                @if (!game.IsOwned) { <span class="ownership-tag">Niet in bezit</span> }
                <div class="game-collection-details">
                    <div class="game-collection-facts">
                        <span>@game.MinPlayers–@(game.MaxPlayers?.ToString() ?? "∞") spelers</span>
                        <span>≈@game.EstimatedMinutes min.</span>
                    </div>
                    <div class="game-collection-plays">
                        @if (playCount == 0)
                        {
                            <span class="game-collection-unplayed">Nog niet<br>gespeeld</span>
                        }
                        else
                        {
                            <strong>@playCount</strong>
                            <span>keer gespeeld</span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
    @if (!games.Any(MatchesFilters))
    {
        <p class="empty">Geen bordspellen gevonden.</p>
    }
}
