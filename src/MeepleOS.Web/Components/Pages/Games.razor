@page "/games"
@inject BoardgameService GameService
@inject GameExpansionService ExpansionService
@inject GameSessionService SessionService
<PageTitle>Bordspellen · MeepleOS</PageTitle>
<h1>Bordspelcollectie</h1>
<div class="filters">
    <label>
        Zoeken
        <input @bind="search" @bind:event="oninput" placeholder="Naam bordspel" />
    </label>
    <label>
        Spelers
        <input type="number" min="1" @bind="players" />
    </label>
    <label>
        Max. minuten
        <input type="number" min="1" @bind="minutes" />
    </label>
</div>
@if (games is null)
{
    <p>Laden…</p>
}
else
{
    <div class="grid">
        @foreach (var game in games.Where(MatchesFilters))
        {
            <article class="card">
                <h2>
                    <a href="/games/@game.Id">@game.Name</a>
                </h2>
                <p>@game.MinPlayers–@(game.MaxPlayers?.ToString() ?? "∞") spelers · circa @game.EstimatedMinutes min.</p>
                <p>@sessions!.Count(s => s.BoardGameId == game.Id) potjes</p>
                <small>@string.Join(", ", expansions!.Where(e => e.BoardGameId == game.Id).Select(e => e.Name))</small>
            </article>
        }
    </div>
    @if (!games.Any(MatchesFilters))
    {
        <p class="empty">Geen bordspellen gevonden.</p>
    }
}
