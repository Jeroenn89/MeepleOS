@page "/chat"
@inject ChatService ChatService
@inject IJSRuntime JS
<PageTitle>AI-chat · MeepleOS</PageTitle>
<h1>AI-chat</h1>
<p class="intro">Stel een vraag of registreer een potje in het Nederlands.</p>
<div class="chat-window" aria-live="polite" @ref="chatWindow">
    @foreach (var exchange in ChatService.Conversation.Exchanges)
    {
        <p class="chat-message user">
            <b>Jij</b>
            <span class="chat-message-text">@exchange.Request</span>
        </p>
        @if (exchange.Response is not null)
        {
            <p class="chat-message assistant">
                <b>MeepleOS</b>
                <span class="chat-message-text">@RenderMessage(exchange.Response)</span>
            </p>
            <p class="chat-request-counts">Gemini-verzoeken: @exchange.GeminiRequests · Tavily-verzoeken: @exchange.TavilyRequests</p>
        }
    }
    @if (busy)
    {
        <div class="chat-loading" role="status" aria-label="MeepleOS is aan het nadenken...">
            <span class="chat-spinner" aria-hidden="true"></span>
            <span>MeepleOS is aan het nadenken...</span>
        </div>
    }
</div>
@if(pending is not null)
{
    <div class="card confirm">
        <p>Bevestig deze ingrijpende opdracht voordat ik hem uitvoer:</p>
        <blockquote>@pending.Request</blockquote>
        <button class="danger" disabled="@busy" @onclick="Confirm">Bevestig en voer uit</button>
        <button class="secondary" disabled="@busy" @onclick="Cancel">Annuleren</button>
    </div>
}
<div class="chat-form">
    <label for="prompt">
        Je bericht
    </label>
    <textarea id="prompt" @bind="prompt" disabled="@busy">
    </textarea>
    <button disabled="@busy" @onclick="Send">@(busy?"Bezig…":"Verstuur")</button>
</div>
