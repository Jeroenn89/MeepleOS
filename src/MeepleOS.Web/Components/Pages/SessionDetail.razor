@page "/sessions/{Id:int}"
@inject GameSessionService Sessions
<PageTitle>@(session?.BoardGameName ?? "Potje") · MeepleOS</PageTitle>
@if (session is null)
{
    <div class="profile-not-found card">
        <h1>Potje niet gevonden</h1>
        <a href="/sessions">Terug naar potjes →</a>
    </div>
}
else
{
    <a class="profile-back" href="/sessions">← Alle potjes</a>
    <header class="profile-hero session-detail-hero">
        <div class="profile-hero-main">
            <time class="session-detail-date" datetime="@session.PlayedAt.ToString("yyyy-MM-dd")">
                <strong>@session.PlayedAt.ToString("dd")</strong>
                <span>@session.PlayedAt.ToString("MM-yyyy")</span>
            </time>
            <div>
                <span class="profile-eyebrow">Gespeeld potje</span>
                <h1><a href="/games/@session.BoardGameId">@session.BoardGameName</a></h1>
                <p>@session.Players.Count @(session.Players.Count == 1 ? "deelnemer" : "deelnemers") · @session.Players.Count(player => player.IsWinner) @(session.Players.Count(player => player.IsWinner) == 1 ? "winnaar" : "winnaars")</p>
            </div>
        </div>
        <a class="button secondary" href="/manage">Wijzigen of verwijderen</a>
    </header>

    <div class="profile-grid session-detail-grid">
        <section class="card profile-panel profile-panel-wide">
            <h2>Deelnemers en uitslag</h2>
            <div class="session-detail-players">
                @foreach (var player in session.Players)
                {
                    <div class="session-detail-player">
                        <a href="/players/@player.PlayerId">@player.PlayerName</a>
                        @if (player.IsWinner)
                        {
                            <span class="profile-win-tag">Winnaar</span>
                        }
                        @if (player.Score.HasValue)
                        {
                            <span>Score: @player.Score</span>
                        }
                        @if (player.Position.HasValue)
                        {
                            <span>Positie: @player.Position</span>
                        }
                    </div>
                }
            </div>
        </section>
        <section class="card profile-panel">
            <h2>Uitbreidingen</h2>
            <p class="profile-muted">@(session.Expansions.Count == 0 ? "Geen uitbreidingen gebruikt." : string.Join(", ", session.Expansions.Select(expansion => expansion.Name)))</p>
        </section>
        <section class="card profile-panel">
            <h2>Opmerkingen</h2>
            <p class="profile-muted">@(string.IsNullOrWhiteSpace(session.Notes) ? "Geen opmerkingen." : session.Notes)</p>
        </section>
    </div>
}
